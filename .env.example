# Environment Variables — Bill & Subscription Watcher
# Copy this to .env and fill in your values

# ─── Strands Agent / AWS Bedrock ───────────────────────────────────────────
# Required to run the agent via Amazon Bedrock (Claude 3.5 Sonnet)
AWS_DEFAULT_REGION=us-east-1
AWS_ACCESS_KEY_ID=your-access-key-id
AWS_SECRET_ACCESS_KEY=your-secret-access-key

# Alternative: use Anthropic directly (skip AWS vars above)
# ANTHROPIC_API_KEY=your-anthropic-api-key

# ─── Django API ────────────────────────────────────────────────────────────
# Base URL the Strands agent uses to call Django endpoints
BILLWATCH_API_URL=http://127.0.0.1:8000/api

# ─── Django ────────────────────────────────────────────────────────────────
# Falls back to a dev-only key if unset — set this to a long random string
# for anything beyond local demo use.
# DJANGO_SECRET_KEY=your-secret-key-here
# DJANGO_DEBUG=True
# DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
